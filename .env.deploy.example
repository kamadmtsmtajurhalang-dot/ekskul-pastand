# Konfigurasi Otomatisasi Deploy GitHub & PythonAnywhere
# Salin file ini menjadi .env.deploy dan isi dengan nilai yang sesuai

# 1. Konfigurasi GitHub
GITHUB_USERNAME=
GITHUB_REPO=
GITHUB_TOKEN=

# 2. Konfigurasi PythonAnywhere
PYTHONANYWHERE_USERNAME=
PYTHONANYWHERE_API_TOKEN=
# Domain webapp Anda di PythonAnywhere, biasanya: username.pythonanywhere.com
PYTHONANYWHERE_DOMAIN=
